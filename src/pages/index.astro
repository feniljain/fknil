---
import BaseLayout from "@layouts/BaseLayout.astro";
import GithubLogo from "@assets/svgs/github.svg";
import LinkedinLogo from "@assets/svgs/linkedin.svg";
import TwitterLogo from "@assets/svgs/twitter.svg";
import EmailLogo from "@assets/svgs/email.svg";
---

<BaseLayout>
    <div class="name">Fenil Jain</div>
    <div class="tagline">I make black boxes for programmers</div>
    <div class="socials">
        <a
            class="social"
            href="https://github.com/feniljain"
            aria-label="Github"
            target="_blank"
        >
            <GithubLogo />
        </a>

        <a
            class="social"
            href="https://linkedin.com/in/fenil-k-jain"
            aria-label="Linkedin"
            target="_blank"
        >
            <LinkedinLogo />
        </a>

        <a
            class="social"
            href="mailto:fkjainco@gmail.com"
            aria-label="Email"
            target="_blank"
        >
            <EmailLogo />
        </a>
    </div>
</BaseLayout>

<style>
    .name {
        font-size: var(--step-5);
    }

    .tagline {
        font-size: 1.6rem;
        text-align: center;
        font-style: italic;
    }

    .socials {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        fill: var(--text);
    }

    /* Follow LVHA rule for anchor tags */
    .social:visited {
        fill: var(--text);
    }

    .social:hover {
        fill: var(--logo-backdrop);
    }

    .social {
        width: 2.5rem;
        height: 2.5rem;
        fill: var(--text);

        margin: 10% 5% 0 5%;
    }

    /* Mobile-only styles */
    @media (max-width: 480px) {
        .socials {
            width: 40%;
        }

        .name {
            font-size: 2.8rem;
        }

        .tagline {
            font-size: 1.4rem;
        }
    }
</style>
