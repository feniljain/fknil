---
import BasePageLayout from '../layouts/BasePageLayout.astro';
import GithubLogo from '../assets/github.svg';
import LinkedinLogo from '../assets/linkedin.svg';
import TwitterLogo from '../assets/twitter.svg';
---

<BasePageLayout>
    <div class="name">Fenil Jain</div>
        <div class="tagline">I make black boxes for programmers</div>
            <div class="socials">
                <div class="social">
                    <a href="https://github.com/feniljain" aria-label="Github">
                        <GithubLogo />
                    </a>
                </div>
                <div class="social">
                    <a href="https://linkedin.com/fenil-k-jain" aria-label="Github">
                        <LinkedinLogo />
                    </a>
                </div>
                <div class="social">
                    <a href="https://twitter.com/fenil_jain_" aria-label="Github">
                        <TwitterLogo />
                    </a>
                </div>
            </div>
        </div>
    </div>
</BasePageLayout>

<style>
    .name {
        font-size: 3.5rem;
        font-weigth: bolder;
    }

    .tagline {
        font-size: 1.6rem;
        text-align: center;
    }

    .socials {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 15%;
    }

    .social {
        width: 2.5rem;
        height: 2.5rem;
        fill: white;

        margin: 10% 5% 0 5%;
    }

    .social:hover {
        fill: var(--logo-backdrop);
    }
</style>
