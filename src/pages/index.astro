---
import BasePageLayout from '@layouts/BasePageLayout.astro';
import GithubLogo from '@assets/svgs/github.svg';
import LinkedinLogo from '@assets/svgs/linkedin.svg';
import TwitterLogo from '@assets/svgs/twitter.svg';
---

<BasePageLayout>
    <div class="name">Fenil Jain</div>
        <div class="tagline">I make black boxes for programmers</div>
            <div class="socials">
                <div class="social">
                    <a href="https://github.com/feniljain" aria-label="Github" target="_blank">
                        <GithubLogo />
                    </a>
                </div>
                <div class="social">
                    <a href="https://linkedin.com/fenil-k-jain" aria-label="Linkedin" target="_blank">
                        <LinkedinLogo />
                    </a>
                </div>
                <div class="social">
                    <a href="https://twitter.com/fenil_jain_" aria-label="Twitter" target="_blank">
                        <TwitterLogo />
                    </a>
                </div>
            </div>
        </div>
    </div>
</BasePageLayout>

<style>
    .name {
        font-size: 3.5rem;
        font-weigth: bolder;
    }

    .tagline {
        font-size: 1.6rem;
        text-align: center;
    }

    .socials {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 10%;
    }

    /* Follow LVHA rule for anchor tags */
    .social:visited {
        fill: white;
    }

    .social:hover {
        fill: var(--logo-backdrop);
    }

    .social {
        width: 2.5rem;
        height: 2.5rem;
        fill: white;

        margin: 10% 5% 0 5%;
    }

    /* Mobile-only styles */
    @media (max-width: 480px) {
        .socials {
            width: 40%;
        }

        .name {
            font-size: 2.8rem;
        }

        .tagline {
            font-size: 1.4rem;
        }
    }
</style>
