---
import BasePageLayout from '../layouts/BasePageLayout.astro';
import GithubLogo from '../assets/github.svg';
import LinkedinLogo from '../assets/linkedin.svg';
import TwitterLogo from '../assets/twitter.svg';
---

<BasePageLayout>
    <div class="main-body">
        <div class="main-body-name">Fenil Jain</div>
            <div class="main-body-tagline">I make black boxes for programmers</div>
                <div class="main-body-socials">
                    <div class="main-body-social">
                        <a href="https://github.com/feniljain" aria-label="Github">
                            <GithubLogo />
                        </a>
                    </div>
                    <div class="main-body-social">
                        <a href="https://linkedin.com/fenil-k-jain" aria-label="Github">
                            <LinkedinLogo />
                        </a>
                    </div>
                    <div class="main-body-social">
                        <a href="https://twitter.com/fenil_jain_" aria-label="Github">
                            <TwitterLogo />
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</BasePageLayout>

<style>
    .main-body {
        color: var(--text-color);

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        box-sizing: border-box;
        width: 100%;
        height: 90%;

        font-size: 1.5rem;
        padding: 1%;
    }

    .main-body-name {
        font-size: 3.5rem;
        font-weigth: bolder;
    }

    .main-body-tagline {
        font-size: 1.6rem;
    }

    .main-body-socials {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 15%;
    }

    .main-body-social {
        width: 2.5rem;
        height: 2.5rem;
        fill: white;

        margin: 5%;
    }

    .main-body-social:hover {
        fill: var(--logo-backdrop);
    }
</style>
