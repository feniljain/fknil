---
import { getCollection, render } from 'astro:content';
import BasePageLayoutWithOnlyHeader from '../../layouts/BasePageLayoutWithOnlyHeader.astro';

export async function getStaticPaths() {
    const allBlogsNotDraft = await getCollection('blog', ({ data }) => !data.draft);
    return allBlogsNotDraft.map(blog => {
        return {
            params: { id: blog.data.slug },
            props: { blog },
        };
    });
}

const { blog } = Astro.props;
const { Content } = await render(blog);
---

<BasePageLayoutWithOnlyHeader>
    <div class="main-body">
        <h1>{blog.slug}</h1>
        <Content />
    </div>
</BasePageLayoutWithOnlyHeader>

<style>
.main-body {
    color: var(--text-color);
    width: 50%;
    font-size: 1rem;
    margin: 0 auto 2% auto;
}
</style>
