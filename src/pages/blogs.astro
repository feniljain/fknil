---
import BaseLayout from "@layouts/BaseLayout.astro";
import RssLogo from "@assets/svgs/rss.svg";

import { getCollection } from "astro:content";

const allBlogsNotDraft = await getCollection(
    "blogs",
    ({ data }) => !data.draft,
);

const sortedAllBlogs = allBlogsNotDraft.sort(
    (a, b) => b.data.publishedOn.getTime() - a.data.publishedOn.getTime(),
);
---

<BaseLayout>
    <div class="blog-list-container">
        <div class="blog-list">
            <a  href="/rss.xml" target="_blank">
                <h1 class="rss">
                    RSS Feed
                    <RssLogo width={30} aria-label="RSS icon" />
                </h1>
            </a>

            <ul>
                {sortedAllBlogs.map((blog) => (
                    <li>
                        <a href={`/blog/${blog.data.slug}`}>
                            {blog.data.title} (
                            {blog.data.publishedOn
                                .toISOString()
                                .replace(/T.*/, "")
                                .split("-")
                                .reverse()
                                .join("-")}
                            )
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </div>
</BaseLayout>

<style>
    /* Follow LVHA principles */
    a,
    a:visited {
        color: var(--logo-backdrop);
        text-decoration: none;
    }

    a:hover {
        text-decoration: underline;
    }

    .blog-list-container {
        max-width: 65ch;
        padding-inline: 1rem;
        margin: 1em auto;
    }

    .rss {
        font-size: var(--step-4);
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
        fill: var(--text);
    }

    .rss:hover {
        fill: var(--logo-backdrop);
    }

    ul {
        font-size: var(--step-1)
    }
</style>
