---
import BasePageLayout from '@layouts/BasePageLayout.astro';
import RssLogo from '@assets/svgs/rss.svg';

import { getCollection } from 'astro:content';

const allBlogsNotDraft = await getCollection('blogs', ({ data }) => !data.draft);

const sortedAllBlogs = allBlogsNotDraft.sort((a, b) => b.data.publishedOn.getTime() - a.data.publishedOn.getTime());

---

<BasePageLayout>
    <div class="blog-list-page">
        <div class="rss-feed-parent">
            <a href="/rss.xml" target="_blank">
                RSS Feed:
                 <RssLogo  class="rss-logo"/>
            </a>
        </div>
        <div class="blog-list-body">
            <div class="blog-list">
                <ul>
                    {sortedAllBlogs.map(blog => (
                    <li><a href={`/blog/${blog.data.slug}`}>{blog.data.title} ({blog.data.publishedOn.toISOString().replace(/T.*/,'').split('-').reverse().join('-')})</a></li>
                    ))}
                </ul>
            </div>
        </div>
    <div>
</BasePageLayout>

<style>
    /* Follow LVHA principles */
    a, a:visited {
        color: var(--logo-backdrop);
        text-decoration: none;
    }

    a:hover {
        text-decoration: underline;
    }

    .blog-list-page {
        width: 100%;
    }

    .rss-logo {
        width: 2.1rem;
        height: 2.1rem;
        fill: white;

        margin: 0 0 0 5px;
    }

    .rss-logo:hover {
        fill: var(--logo-backdrop);
    }

    .rss-feed-parent {
        display: flex;
        align-items: center;
        justify-content: center;

        font-size: 2.1rem;
    }

    .blog-list-body {
        display: flex;
        justify-content: center;
        align-items: center;

        box-sizing: border-box;
    }

    .blog-list {
        box-sizing: border-box;
    }
</style>
