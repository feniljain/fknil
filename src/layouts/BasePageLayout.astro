---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>Fenil Jain</title>
	</head>
	<body>
	    <Header />
        <slot />
	    <Footer />
	</body>
</html>

<style>
    :root {
        --bg: #fafafa;
        --fg: #212121;
        --muted: #5a5a5a;
        --logo-backdrop: #1565c0;
        --alt-bg: #e0e0e0;
        --border: #d0d0d0;
        --text-color: #212121;
    }

    @media (prefers-color-scheme: dark) {
        :root {
            --bg: #212121;
            --fg: #dadada;
            --muted: #a0a0a0;
            --logo-backdrop: #42a5f5;
            --alt-bg: #424242;
            --border: #3a3a3a;
            --text-color: #dadada;
        }
    }

    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
        background: var(--bg);
    }

    body {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;

        min-height: 100vh;
        box-sizing: border-box;
    }
</style>
