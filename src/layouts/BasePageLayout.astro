---
import Footer from '../components/Footer.astro';
import BasePageLayoutWithOnlyHeader from './BasePageLayoutWithOnlyHeader.astro';
---

<BasePageLayoutWithOnlyHeader>
    <div class="main-body">
        <slot />
    </div>
    <Footer slot="footer" />
</BasePageLayoutWithOnlyHeader>

<style>
.main-body {
    color: var(--text-color);

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    box-sizing: border-box;
    width: 100%;
    height: 90%;

    font-size: 1.5rem;
    padding: 1%;
}
</style>
