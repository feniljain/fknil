---
import Footer from '../components/Footer.astro';
import BasePageLayoutWithOnlyHeader from './BasePageLayoutWithOnlyHeader.astro';
---

<BasePageLayoutWithOnlyHeader>
    <div class="main-body">
        <slot />
    </div>
    <Footer slot="footer" />
</BasePageLayoutWithOnlyHeader>

<style>
.main-body {
    color: var(--text-color);

    /* center all content of main, blog and about page */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    /* Take remaining space between header and footer */
    flex-grow: 1;

    font-size: 1.5rem;
}
</style>
