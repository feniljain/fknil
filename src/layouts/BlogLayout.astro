---
import BaseLayout from "@layouts/BaseLayout.astro";
import { render } from "astro:content";

const { blog } = Astro.props;
const { Content } = await render(blog);
---

<BaseLayout article>
    <div class="blog-container flow">
        <h1>{blog.data.title}</h1>
        <div class="blog-dates" >
            <p> Published on {blog.data.publishedOn.toLocaleDateString("en-GB")}</p>
            <p> Last edited on {blog.data.lastEditedOn.toLocaleDateString("en-GB")}</p>
        </div>
        <div class="markdown-body flow">
            <Content />
        </div>
    </div>
</BaseLayout>

<style>
    .blog-container {
        color: var(--text);
        /* not have blog content stick to vertical sidewalls */
        max-width: 65ch;
        padding-inline: 1rem;
        margin: 0 auto 3em auto;
    }

    h1 {
        margin-top: 0.5em;
        text-align: center;
    }

    .blog-dates {
        font-size: var(--step--1);
    }

    /* Follow LVHA principles */
    .blog-container :global(a) {
        color: var(--logo-backdrop);
        text-decoration: none;

        &:visited {
            color: var(--logo-backdrop);
        }

        &:hover {
            text-decoration: underline;
        }
    }
</style>
