---
import BasePageLayoutWithOnlyHeader from '@layouts/BasePageLayoutWithOnlyHeader.astro';
import { render } from 'astro:content';

const { blog } = Astro.props;
const { Content } = await render(blog);
---

<BasePageLayoutWithOnlyHeader>
    <div class="main-body">
        <div class="blog-title">{blog.data.title}</div>
        <p class="blog-dates">Published on: {blog.data.publishedOn.toLocaleDateString('en-GB')}</p>
        <p class="blog-dates">Last edited on: {blog.data.lastEditedOn.toLocaleDateString('en-GB')}</p>
        <Content />
    </div>
</BasePageLayoutWithOnlyHeader>

<style>
    .main-body {
        color: var(--text-color);
        width: 70%;
        margin: 1% auto 2% auto;
    }

    .blog-title {
        text-align: center;
        font-size: 3rem;
    }

    .blog-dates {
        font-size: 1.3rem;
    }

    /* Follow LVHA principles */
    .main-body :global(a),
    .main-body :global(a:visited) {
        color: var(--logo-backdrop);
        text-decoration: none;
    }

    .main-body :global(a:hover) {
        text-decoration: underline;
    }

    /* Mobile-only styles */
    @media (max-width: 480px) {
        .main-body {
            width: 90%;
            margin: 2% auto 5% auto;
        }

        .blog-title {
            font-size: 2rem;
        }

        .blog-dates {
            font-size: 1rem;
        }
    }
</style>
